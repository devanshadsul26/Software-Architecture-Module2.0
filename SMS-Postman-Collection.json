              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@sms.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "http://localhost:5001/api/login/admin",
              "host": ["localhost"],
              "port": "5001",
              "path": ["api", "login", "admin"]
